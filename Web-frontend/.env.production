# ============================================================
# 生产环境配置（npm run build 时生效）
# 部署前必须把占位地址替换为真实服务器地址，否则 AI 助手无法连接！
# ============================================================

# 语音问答服务 WebSocket 地址
# 必须是 wss://（HTTPS 部署下浏览器拦截非安全 ws://）
# 推荐走 Nginx 反代：wss://<你的域名>/voice-ws -> 127.0.0.1:8765
VITE_VOICE_WS_URL=ws://120.26.225.135/voice-ws

# 若部署环境不提供后端语音服务，改为取消下一行注释（前端优雅禁用 AI 助手）
# VITE_VOICE_DISABLE=1
