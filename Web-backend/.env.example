YILAN_ENV=development
YILAN_CONFIG_DIR=configs
YILAN_PROVIDER_PROFILE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.2
DASHSCOPE_API_KEY=

# NVIDIA NIM embedding（可选，bge-m3 供应商）
NVIDIA_API_KEY=

# HuggingFace 本地模型缓存（BGE_M3 离线推理）
HF_HOME=
TRANSFORMERS_OFFLINE=1

# 记忆系统（cutover 能力键 / outbox 密钥，可选）
MEMORY_CUTOVER_CAPABILITY_KEY=
MEMORY_OUTBOX_KEY=
